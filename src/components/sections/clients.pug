section.section(aria-labelledby="clients-title")
  .container
    h2#clients-title.section-title Clients &amp; kind words
    p.section-intro Some of the people and brands we’ve been lucky to work with.
    ul.clients
      each client, i in clients
        li.clients__item
          span.client(class=`client--${i + 1}`)= client
    figure.testimonial
      span.testimonial__mark(aria-hidden="true") “
      blockquote.testimonial__quote
        p= testimonial.quote
      figcaption.testimonial__footer
        span.testimonial__person
          span.avatar(aria-hidden="true")= testimonial.initials
          span.testimonial__meta
            span.testimonial__name= testimonial.name
            span.testimonial__role= testimonial.role
        span.slider-dots(aria-hidden="true")
          each dot, i in Array(testimonial.dots).fill(0)
            span.slider-dots__dot(class={ "slider-dots__dot--active": i === 0 })
