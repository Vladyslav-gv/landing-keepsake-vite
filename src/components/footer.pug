footer.footer
  .container
    .footer__top
      .footer__links
        each col in footerColumns
          nav.footer__col(aria-labelledby=`footer-${col.id}`)
            h2.footer__title(id=`footer-${col.id}`)= col.title
            ul.footer__list
              each link in col.links
                li
                  a.footer__link(href=link.href)= link.text
      .newsletter#newsletter
        h2.footer__title Newsletter
        //- Без JS: submit веде на #subscribed, :target показує повідомлення
        form.newsletter__form(action="#subscribed" method="get")
          p.newsletter__text From new case studies and design notes, once a month.
          .newsletter__row
            label.visually-hidden(for="newsletter-email") Email address
            input.newsletter__input.newsletter__input--email#newsletter-email(type="email" name="email" placeholder="Your email address" autocomplete="email" required aria-describedby="newsletter-email-error")
            +btn('Subscribe', null)(type="submit")
          p.newsletter__error.newsletter__error--email#newsletter-email-error Please enter a valid email address.
          .newsletter__consent
            input.newsletter__checkbox#newsletter-consent(type="checkbox" name="consent" required aria-describedby="newsletter-consent-error")
            label(for="newsletter-consent") I agree to receive emails and accept the privacy policy
          p.newsletter__error.newsletter__error--consent#newsletter-consent-error Please tick the box to continue.
        p.newsletter__success#subscribed(role="status")
          +icon('check')
          | You’re all set! Check your inbox to confirm.
    .footer__bottom
      p.footer__copy © #{site.year} #{site.name}. All rights reserved.
      +socials(socials)